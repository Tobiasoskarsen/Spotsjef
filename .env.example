# Kopier denne fila til .env.local og fyll inn dine egne nøkler.
# .env.local committes ALDRI (ligger i .gitignore).

# Anthropic API-nøkkel for AI-innsikt. Hentes fra https://console.anthropic.com
ANTHROPIC_API_KEY=

# --- Push-varsler (valgfritt; appen fungerer uten) ---

# VAPID-nøkler (generert med `npx web-push generate-vapid-keys`).
# Den offentlige må ha NEXT_PUBLIC_-prefiks (brukes i nettleseren).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# (Valgfritt) identifiserer deg overfor push-leverandørene
VAPID_SUBJECT=mailto:din@epost.no

# Lagring av push-abonnement i Supabase (Postgres – gratis nivå).
# Hentes i Supabase: Project Settings → API. service_role er HEMMELIG (kun server).
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Hemmelighet som beskytter cron-endepunktet (/api/cron/sjekk-priser).
# Velg en lang, tilfeldig streng.
CRON_SECRET=
